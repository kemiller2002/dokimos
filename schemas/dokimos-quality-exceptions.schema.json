{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/dokimos/schemas/quality-exceptions",
  "title": "Dokimos quality exceptions (quality/exceptions.json)",
  "description": "Reviewed, owned, expiring exceptions. Each accepts one regression of one rule in one scope up to allowedValue (required for DOK-R rules). Expired or incomplete exceptions fail `dokimos ratchet check` with verdict invalid-exceptions (exit 6). Exceptions never modify the baseline. DOK-G001 exceptions (scope = finding id) replace policy suppressions for `dokimos evaluate --exceptions`.",
  "type": "object",
  "required": [
    "contract",
    "schemaVersion",
    "exceptions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "const": "dokimos.quality-exceptions"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ruleId",
          "scope",
          "rationale",
          "owner",
          "created",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "pattern": "^DOK-(R|G)\\d{3}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "created": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reviewCondition": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "allowedValue": {
            "type": "number",
            "minimum": 0
          }
        },
        "anyOf": [
          {
            "required": [
              "expires"
            ]
          },
          {
            "required": [
              "reviewCondition"
            ]
          }
        ]
      }
    }
  }
}
