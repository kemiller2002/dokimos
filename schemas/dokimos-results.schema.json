{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/dokimos/schemas/results",
  "title": "Dokimos results",
  "description": "Application-facing projection of evidence, comparison, evaluation and history (`dokimos results`). Consumers render it; they never recompute quality judgments.",
  "type": "object",
  "required": [
    "Contract",
    "SchemaVersion",
    "DokimosVersion",
    "Overview",
    "Current",
    "Baseline",
    "Outcomes",
    "Improvements",
    "Regressions",
    "Findings",
    "Hotspots",
    "Trends",
    "Provenance",
    "Unavailable"
  ],
  "properties": {
    "Contract": {
      "const": "dokimos.results"
    },
    "SchemaVersion": {
      "const": "1.0.0"
    },
    "DokimosVersion": {
      "type": "string",
      "minLength": 1
    },
    "Overview": {
      "$ref": "#/$defs/overview"
    },
    "Current": {
      "$ref": "#/$defs/snapshotRef"
    },
    "Baseline": {
      "$ref": "#/$defs/snapshotRef"
    },
    "Outcomes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "Improvements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "Regressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "Findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "Hotspots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotspot"
      }
    },
    "Trends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/series"
      }
    },
    "Provenance": {
      "$ref": "#/$defs/provenance"
    },
    "Unavailable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unavailable"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "overview": {
      "type": "object",
      "required": [
        "Disposition",
        "ExitCode",
        "Summary",
        "OutcomeCounts",
        "MetricsAvailable",
        "MetricsUnavailable",
        "MetricsFailed",
        "Findings",
        "Hotspots",
        "StoredSnapshots"
      ],
      "properties": {
        "Disposition": {
          "enum": [
            "passed",
            "passed-with-warnings",
            "failed",
            "required-evidence-unavailable",
            "incompatible-snapshots"
          ]
        },
        "ExitCode": {
          "enum": [
            0,
            3,
            4
          ]
        },
        "Summary": {
          "$ref": "#/$defs/summary"
        },
        "OutcomeCounts": {
          "type": "object"
        },
        "MetricsAvailable": {
          "type": "integer",
          "minimum": 0
        },
        "MetricsUnavailable": {
          "type": "integer",
          "minimum": 0
        },
        "MetricsFailed": {
          "type": "integer",
          "minimum": 0
        },
        "Findings": {
          "type": "integer",
          "minimum": 0
        },
        "Hotspots": {
          "type": "integer",
          "minimum": 0
        },
        "StoredSnapshots": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "Improved",
        "Deteriorated",
        "Unchanged",
        "Changed",
        "Added",
        "Removed",
        "Incompatible",
        "Unavailable",
        "FindingsIntroduced",
        "FindingsResolved",
        "FindingsPersistent",
        "FindingsUnavailable"
      ],
      "properties": {
        "Improved": {
          "type": "integer",
          "minimum": 0
        },
        "Deteriorated": {
          "type": "integer",
          "minimum": 0
        },
        "Unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "Changed": {
          "type": "integer",
          "minimum": 0
        },
        "Added": {
          "type": "integer",
          "minimum": 0
        },
        "Removed": {
          "type": "integer",
          "minimum": 0
        },
        "Incompatible": {
          "type": "integer",
          "minimum": 0
        },
        "Unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "FindingsIntroduced": {
          "type": "integer",
          "minimum": 0
        },
        "FindingsResolved": {
          "type": "integer",
          "minimum": 0
        },
        "FindingsPersistent": {
          "type": "integer",
          "minimum": 0
        },
        "FindingsUnavailable": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "snapshotRef": {
      "type": "object",
      "required": [
        "SnapshotId",
        "SchemaVersion",
        "Repository",
        "Revision",
        "Ref",
        "CollectedAt",
        "DokimosVersion"
      ],
      "properties": {
        "SnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "SchemaVersion": {
          "enum": [
            "1.0.0",
            "2.0.0"
          ]
        },
        "Repository": {
          "type": "string",
          "minLength": 1
        },
        "Revision": {
          "type": "string",
          "minLength": 1
        },
        "Ref": {
          "type": "string"
        },
        "CollectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "DokimosVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": [
        "MetricId",
        "Scope",
        "Kind",
        "Before",
        "After",
        "Delta"
      ],
      "properties": {
        "MetricId": {
          "type": "string",
          "minLength": 1
        },
        "Scope": {
          "type": "string",
          "minLength": 1
        },
        "Kind": {
          "enum": [
            "improved",
            "deteriorated"
          ]
        },
        "Before": {
          "anyOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "type": "null"
            }
          ]
        },
        "After": {
          "anyOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "type": "null"
            }
          ]
        },
        "Delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": [
        "State",
        "Value",
        "Reason",
        "Detail"
      ],
      "properties": {
        "State": {
          "enum": [
            "available",
            "unavailable",
            "failed"
          ]
        },
        "Value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "Reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "Detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "State": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "Value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "State": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "Value": {
                "type": "null"
              },
              "Reason": {
                "enum": [
                  "unsupported",
                  "not-configured",
                  "insufficient-evidence"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "State": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "Value": {
                "type": "null"
              },
              "Reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "FindingId",
        "Kind",
        "Scope",
        "FirstSeen",
        "LastSeen",
        "Current",
        "Timeline"
      ],
      "properties": {
        "FindingId": {
          "type": "string",
          "minLength": 1
        },
        "Kind": {
          "type": "string"
        },
        "Scope": {
          "type": "string"
        },
        "FirstSeen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "LastSeen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "Current": {
          "enum": [
            "introduced",
            "persistent",
            "resolved",
            "resurfaced",
            "absent",
            "unavailable",
            "uncertain"
          ]
        },
        "Timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timeline"
          }
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": [
        "SnapshotId",
        "Revision",
        "CollectedAt",
        "State",
        "Note",
        "Evidence"
      ],
      "properties": {
        "SnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "Revision": {
          "type": "string",
          "minLength": 1
        },
        "CollectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "State": {
          "enum": [
            "introduced",
            "persistent",
            "resolved",
            "resurfaced",
            "absent",
            "unavailable",
            "uncertain"
          ]
        },
        "Note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "Evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        }
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "Kind",
        "Value"
      ],
      "properties": {
        "Kind": {
          "enum": [
            "structural-complexity",
            "frequent-change",
            "high-churn",
            "repeated-region",
            "active-findings",
            "aged-debt",
            "api-instability",
            "dependency-additions",
            "missing-test-change",
            "type-weakening"
          ]
        },
        "Value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "hotspot": {
      "type": "object",
      "required": [
        "FindingId",
        "Scope",
        "Kind",
        "Explanation",
        "Dimensions",
        "Signals",
        "Lifecycle"
      ],
      "properties": {
        "FindingId": {
          "type": "string",
          "minLength": 1
        },
        "Scope": {
          "type": "string"
        },
        "Kind": {
          "type": "string"
        },
        "Explanation": {
          "type": "string"
        },
        "Dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "structural",
              "temporal",
              "debt",
              "api",
              "dependency",
              "test"
            ]
          }
        },
        "Signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Kind",
              "Dimension",
              "Value"
            ],
            "properties": {
              "Kind": {
                "type": "string"
              },
              "Dimension": {
                "enum": [
                  "structural",
                  "temporal",
                  "debt",
                  "api",
                  "dependency",
                  "test"
                ]
              },
              "Value": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "Lifecycle": {
          "enum": [
            "introduced",
            "persistent",
            "resolved",
            "resurfaced",
            "absent",
            "unavailable",
            "uncertain"
          ]
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": [
        "MetricId",
        "Scope",
        "Unit",
        "Preference",
        "Points",
        "FirstSeen",
        "LastSeen",
        "Latest",
        "Best",
        "Baseline",
        "BaselineDistance",
        "IncompatibleVersions",
        "Notes"
      ],
      "properties": {
        "MetricId": {
          "type": "string",
          "minLength": 1
        },
        "Scope": {
          "type": "string",
          "minLength": 1
        },
        "Unit": {
          "type": "string"
        },
        "Preference": {
          "enum": [
            "lower-is-better",
            "higher-is-better",
            "contextual"
          ]
        },
        "Points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "FirstSeen": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "LastSeen": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "Latest": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "Best": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "Baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "BaselineDistance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "IncompatibleVersions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "Notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": [
        "SnapshotId",
        "Revision",
        "CollectedAt",
        "MetricVersion",
        "Measurement"
      ],
      "properties": {
        "SnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "Revision": {
          "type": "string",
          "minLength": 1
        },
        "CollectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "MetricVersion": {
          "type": "integer",
          "minimum": 1
        },
        "Measurement": {
          "$ref": "#/$defs/measurement"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "Repository",
        "Revision",
        "Ref",
        "CollectedAt",
        "DokimosVersion",
        "ConfigurationId",
        "AnalyzedScope",
        "Analyzers",
        "Policy",
        "Performance"
      ],
      "properties": {
        "Repository": {
          "type": "string",
          "minLength": 1
        },
        "Revision": {
          "type": "string",
          "minLength": 1
        },
        "Ref": {
          "type": "string"
        },
        "CollectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "DokimosVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ConfigurationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "AnalyzedScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Analyzers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "AnalyzerId",
              "Version",
              "State",
              "Reason",
              "DurationMilliseconds"
            ],
            "properties": {
              "AnalyzerId": {
                "type": "string",
                "minLength": 1
              },
              "Version": {
                "type": "string"
              },
              "State": {
                "enum": [
                  "ran",
                  "not-run",
                  "failed"
                ]
              },
              "Reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "DurationMilliseconds": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "Policy": {
          "type": "object"
        },
        "Performance": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "TotalMilliseconds",
                "FileCount",
                "ObservationCount",
                "UnavailableCollectors",
                "FailedCollectors"
              ],
              "properties": {
                "TotalMilliseconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "FileCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "ObservationCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "UnavailableCollectors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "FailedCollectors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "unavailable": {
      "type": "object",
      "required": [
        "Subject",
        "Scope",
        "State",
        "Reason",
        "Explanation"
      ],
      "properties": {
        "Subject": {
          "type": "string",
          "minLength": 1
        },
        "Scope": {
          "type": "string",
          "minLength": 1
        },
        "State": {
          "enum": [
            "unavailable",
            "failed"
          ]
        },
        "Reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "Explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
