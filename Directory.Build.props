<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <!-- Dokimos release version. Release tags are dokimos-v$(Version). -->
    <Version>0.1.0</Version>
    <Authors>Echelon Foundry</Authors>
    <IsPackable>false</IsPackable>
    <RepositoryUrl>https://github.com/kemiller2002/dokimos</RepositoryUrl>
    <!-- MIT (LICENSE). As sole copyright holder the owner can license later
         versions differently; published versions stay MIT. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- FSharp.Core is pinned rather than implied by whichever SDK builds the
         solution, so every toolchain produces the same dependency graph.
         Aegis.Core 1.0.0 requires FSharp.Core >= 10.1.400. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <PackageReference Include="FSharp.Core" Version="10.1.400" />
  </ItemGroup>
</Project>
