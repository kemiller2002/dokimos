{
  "$schema": "../schemas/dokimos-policy.schema.json",
  "schemaVersion": "1.2.0",
  "baseline": "BASELINE-0001",
  "requiredEvidence": [
    "build.compiler-errors",
    "build.compiler-warnings",
    "tests.total",
    "tests.failed"
  ],
  "ratchets": [
    {
      "metricId": "build.compiler-errors",
      "metricVersion": 1,
      "bestAccepted": "baseline",
      "preference": "lower-is-better",
      "disposition": "fail"
    },
    {
      "metricId": "build.compiler-warnings",
      "metricVersion": 1,
      "bestAccepted": "baseline",
      "preference": "lower-is-better",
      "disposition": "fail"
    },
    {
      "metricId": "tests.failed",
      "metricVersion": 1,
      "bestAccepted": "baseline",
      "preference": "lower-is-better",
      "disposition": "fail"
    }
  ],
  "thresholds": [],
  "regressions": {
    "disposition": "warn"
  },
  "introducedFindings": {
    "disposition": "warn"
  },
  "observedNotRatcheted": [
    "tests.total",
    "tests.passed"
  ],
  "unavailableBehavior": "not-evaluated"
}
