{
  "name": "dokimos-site",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Static public website for Dokimos. The F# system itself builds with dotnet; this manifest only drives the site and its Echelon verification tooling.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node site/build.mjs",
    "serve": "node site/build.mjs && node site/serve.mjs",
    "test": "node --test \"site/test/*.test.mjs\" \"results-ui/test/*.test.mjs\"",
    "echelon:visual:verify": "visual-engineering verify --strict",
    "praxis:validate": "./praxis validate",
    "audit": "node site/audit.mjs",
    "results:render": "node results-ui/render.mjs",
    "results:audit": "node results-ui/audit.mjs",
    "results:report": "node results-ui/report.mjs",
    "results:pdf": "node results-ui/export-pdf.mjs",
    "test:icons": "node --test site/test/icon-usage.test.mjs",
    "icons:audit": "node tools/icon-usage-audit.mjs"
  },
  "devDependencies": {
    "@echelon-foundry/design-system": "https://github.com/kemiller2002/forma/releases/download/v1.0.1/echelon-foundry-design-system-1.0.1.tgz",
    "@echelon-foundry/echelon-theme": "https://github.com/kemiller2002/echelon-design-system/releases/download/v1.1.0/echelon-foundry-echelon-theme-1.1.0.tgz",
    "@echelon-foundry/print-components": "https://github.com/kemiller2002/folio/releases/download/v0.4.1/echelon-foundry-print-components-0.4.1.tgz",
    "@echelon-foundry/visual-engineering": "1.0.1",
    "axe-core": "4.13.0",
    "playwright": "1.63.0"
  }
}
