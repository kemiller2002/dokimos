<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Digest.fs" />
    <Compile Include="Inputs.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Scanner.fs" />
    <Compile Include="AstScanner.fs" />
    <Compile Include="AuthorityMatch.fs" />
    <Compile Include="Provenance.fs" />
    <Compile Include="Oracle.fs" />
